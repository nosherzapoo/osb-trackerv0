[Unit]
Description=OSB tracker — scrape tier 4-5
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/osb-trackerv0
ExecStart=/srv/osb-trackerv0/scripts/systemd/run_tier.sh 45
TimeoutStartSec=30min
RuntimeMaxSec=60min
MemoryMax=1G
MemorySwapMax=512M
TasksMax=300
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s
Nice=10
StandardOutput=journal
StandardError=journal
