[Unit]
Description=OSB tracker — scrape tier 4-5
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/osb-trackerv0
ExecStart=/srv/osb-trackerv0/scripts/systemd/run_tier.sh 45
TimeoutStartSec=30min
Nice=10
StandardOutput=journal
StandardError=journal
