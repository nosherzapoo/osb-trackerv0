[Unit]
Description=OSB tracker — weekly full backfill of every state
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/osb-trackerv0
ExecStart=/srv/osb-trackerv0/scripts/systemd/run_full.sh
TimeoutStartSec=12h
RuntimeMaxSec=6h
MemoryMax=1500M
MemorySwapMax=512M
TasksMax=300
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s
Nice=15
StandardOutput=journal
StandardError=journal
